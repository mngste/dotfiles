/* rofi : même apparence que fuzzel (~/.config/fuzzel/fuzzel.ini).
   fuzzel lance les applis (Mod+D) ; rofi sert aux fenêtres, commandes et
   hôtes SSH (Mod+Shift+D), ce que fuzzel ne sait pas faire.
   Correspondance des réglages fuzzel -> rofi indiquée en commentaire. */

configuration {
    combi-modes: [window,run,ssh,drun];
    modi: "combi";
    sort: true;
    sorting-method: "fzf";               /* match-mode=fzf */
    matching: "fuzzy";
    show-icons: true;
    drun-match-fields: "name,generic,categories,exec,keywords";  /* fields= */
    display-combi: "> ";                 /* prompt="> " */
    terminal: "kitty";                   /* terminal=kitty -e */
    ssh-client: "kitten ssh";
    ssh-command: "{terminal} -e {ssh-client} {host} [-p {port}]";
}

@theme "tokyo"

* {
    font: "JetBrainsMono Nerd Font 12";  /* font= */
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;                    /* anchor=center */
    width: 40ch;                         /* width=40 (caractères) */
    border: 1px;                         /* [border] width=1 */
    border-radius: 8px;                  /* [border] radius=8 */
    border-color: @border;
    background-color: @bg;
}

mainbox {
    padding: 8px 16px;                   /* vertical-pad=8, horizontal-pad=16 */
    spacing: 8px;                        /* inner-pad=8 */
}

inputbar {
    spacing: 8px;
    children: [prompt, entry, num-filtered-rows];
}

prompt   { text-color: @fg; }
entry    { placeholder: "search"; placeholder-color: @dim; }
num-filtered-rows { text-color: @dim; }  /* match-counter=yes */

listview {
    lines: 15;                           /* lines=15 */
    fixed-height: false;                 /* minimal-lines=yes */
    scrollbar: false;
}

element {
    padding: 2px 4px;
    spacing: 8px;
    border-radius: 4px;
}

element selected normal,
element selected active {
    background-color: @selection;        /* selection= */
}

element normal urgent   { text-color: @red; }
element normal active   { text-color: @blue; }

element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    highlight: bold #2ac3de;              /* match=, selection-match= */
}
