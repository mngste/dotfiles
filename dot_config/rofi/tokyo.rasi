/* Tokyo Night : mêmes couleurs que fuzzel (~/.config/fuzzel/fuzzel.ini, section [colors]) */
* {
  bg        : #16161e;   /* background */
  fg        : #c0caf5;   /* text, selection-text */
  match     : #2ac3de;   /* match, selection-match */
  selection : #343a55;   /* selection */
  border    : #27a1b9;   /* border */
  dim       : #565f89;   /* placeholder */
  red       : #f7768e;
  blue      : #7aa2f7;
}
