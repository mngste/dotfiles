{{ if eq .osid "linux-fedora" -}}
#!/bin/sh
set -eu

sudo dnf copr enable -y lihaohong/yazi
# yazi + aperçus (vidéo, archives, PDF, images)
sudo dnf install -y yazi ffmpeg-free 7zip poppler-utils ImageMagick

{{ else if eq .osid "linux-arch" -}}
#!/bin/sh
set -eu

sudo pacman -S --needed --noconfirm yazi ffmpeg 7zip poppler resvg imagemagick

{{ end -}}
