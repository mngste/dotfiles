#!/bin/sh
# Capture d'écran sous Sway : capture [zone|ecran|fenetre]
# Enregistre dans ~/Images/Captures (dossier Images de la langue du système)
# et copie l'image dans le presse-papiers.
set -eu

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Captures"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-zone}" in
    zone)
        geom="$(slurp)" || exit 0          # Échap : on annule sans erreur
        grim -g "$geom" "$file" ;;
    ecran)
        grim -o "$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name')" "$file" ;;
    fenetre)
        geom="$(swaymsg -t get_tree | jq -r '.. | select(.focused? == true) | .rect | "\(.x),\(.y) \(.width)x\(.height)"')"
        grim -g "$geom" "$file" ;;
    *)
        echo "usage : capture [zone|ecran|fenetre]" >&2; exit 1 ;;
esac

wl-copy --type image/png < "$file"
notify-send -i "$file" "Capture enregistrée" "$file" 2>/dev/null || true
